{
  "name": "ciso-backend",
  "version": "1.0.0",
  "description": "CISO Command Center — Node.js API Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
