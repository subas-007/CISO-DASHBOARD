# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Database (SQLite for dev; swap for PostgreSQL DSN in prod) ───────────
DB_PATH=./data/ciso.db

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OAuth2 (optional — for SSO) ─────────────────────────────────────────
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZATION_URL=
OAUTH2_TOKEN_URL=
OAUTH2_CALLBACK_URL=http://localhost:4000/api/auth/oauth/callback

# ── SAML (optional — for enterprise SSO) ────────────────────────────────
SAML_ENTRY_POINT=
SAML_ISSUER=ciso-dashboard
SAML_CERT=

# ── TOTP ────────────────────────────────────────────────────────────────
TOTP_APP_NAME=CISO Dashboard
